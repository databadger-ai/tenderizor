# Copy to .env.local for local development. Never commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=openai:gpt-5.6-sol
OPENAI_REASONING_EFFORT=medium
DATABASE_URL=postgresql+asyncpg://canadabuys:canadabuys@postgres:5432/canadabuys
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=canadabuys-tender-analysis
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://localhost:3100"]
WEB_PORT=3100
